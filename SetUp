fastqc samplename_001.fastq


#Download RefSeq accession GCF_000002985.6 --include gff3,genome to your personal computer and move data to DIRECTORYNAME directory

ASSEMBLY='GCF_000002985.6_WBcel235_genomic.fna'
ANNOTATION='genomic.gtf'

#Move above files to /N/scratch/ealamb/DIRECTORYNAME/



#Index genome

STAR \
  --runThreadN 16 \
  --runMode genomeGenerate \
  --genomeDir genome/index \
  --genomeFastaFiles GCF_000002985.6_WBcel235_genomic.fna \
  --sjdbGTFfile genomic.gff \
  --sjdbOverhang 149
#From /N/scratch/ealamb/DIRECTORYNAME/ run:

#Align reads

STAR \
  --runThreadN 16 \
  --genomeDir /N/scratch/ealamb/GSF4521/genome/index \
  --readFilesIn GSF4521-EL-polyA_S34_R1_001.fastq GSF4521-EL-polyA_S34_R2_001.fastq \
  --outFileNamePrefix polyA. \
  --alignSJoverhangMin 15 \
  --outFilterMultimapNmax 20 \
  --outSAMtype BAM SortedByCoordinate



mkdir bams
scp *.bam /N/scratch/ealamb/GSF4521/bams/

# Write header to summary file
echo -e "Filename\tTotal_reads\tDedup_reads\tPercent_duplicates" > neural_bam_dedup_summary.tsv

# Loop through all BAM files
for i in *.bam; do
    # Define output deduplicated BAM filename
    out=${i%.bam}.dedup.bam

    # Count total reads
    total=$(samtools view -c "$i")

    # Run markdup, save deduplicated BAM
    samtools markdup -s -r "$i" "$out"

    # Index the deduplicated BAM
    samtools index "$out"

    # Count reads in deduplicated BAM
    dedup=$(samtools view -c "$out")

    # Calculate % duplicates
    dup_percent=$(echo "scale=2; 100*($total-$dedup)/$total" | bc)

    # Append results to summary
    echo -e "$i\t$total\t$dedup\t$dup_percent%"
done >> neural_bam_dedup_summary.tsv
