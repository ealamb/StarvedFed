for sam in *.sam
do
    base=$(basename "$sam" .sam)

    samtools view -bS "$sam" |
    samtools sort -o "${base}.bam"

    samtools index "${base}.bam"
done


for bam in *.bam
do
    base=$(basename "$bam" .bam)

    bedtools coverage \
        -a introns.bed \
        -b "$bam" \
        -d \
        > "${base}_intron_coverage.txt"
done


bedtools coverage \
    -sorted \
    -a introns.sorted.bed \
    -b treat_1Aligned.out.bam \
    -d \
